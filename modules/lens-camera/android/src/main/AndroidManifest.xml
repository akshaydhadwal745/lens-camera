<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Lens works on phones without some cameras (e.g. no back camera on some tablets). -->
  <uses-feature android:name="android.hardware.camera" android:required="false" />
  <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
  <uses-feature android:name="android.hardware.camera.flash" android:required="false" />
  <application>
    <!-- Play services downloads the subject-segmentation model at install time (Portrait for pets/objects). -->
    <meta-data android:name="com.google.mlkit.vision.DEPENDENCIES" android:value="subject_segment" />
  </application>
</manifest>
