<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <!-- Background backup: a foreground service keeps uploads running with a
       visible "Backing up…" notification (like Google Photos). -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

  <application>
    <service
      android:name="expo.modules.lensdevice.BackupService"
      android:exported="false"
      android:foregroundServiceType="dataSync" />
    <!-- Quick-settings tile and home-screen widget: open the Lens camera in one tap. -->
    <service
      android:name="expo.modules.lensdevice.LensTileService"
      android:exported="true"
      android:icon="@drawable/lens_tile"
      android:label="@string/lens_tile_label"
      android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
      <intent-filter>
        <action android:name="android.service.quicksettings.action.QS_TILE" />
      </intent-filter>
    </service>
    <receiver
      android:name="expo.modules.lensdevice.LensWidget"
      android:exported="false"
      android:label="@string/lens_widget_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/lens_widget_info" />
    </receiver>
  </application>
</manifest>
