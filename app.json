{
  "expo": {
    "name": "Lens",
    "slug": "camera-app",
    "scheme": "lens",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1020",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.akshay.lens"
    },
    "android": {
      "package": "com.akshay.lens",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "Lens",
      "shortName": "Lens",
      "themeColor": "#0B1020",
      "backgroundColor": "#0B1020",
      "description": "Lens: your photos and videos, cloud-first."
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-video",
      "expo-sharing",
      "expo-image",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use your camera to take photos and videos.",
          "microphonePermission": "Allow $(PRODUCT_NAME) to record audio with your videos.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your photos.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save photos and videos to your library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "backgroundColor": "#0B1020",
          "resizeMode": "contain"
        }
      ],
      "expo-web-browser",
      "expo-background-task"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
