---
// /e/<code>/: an event album link (QR code at a wedding, trip or party). With
// Lens installed, Android opens the app (App Links) to join and add photos;
// without it, this page shows the album and lets people add photos from the
// browser as a guest (docs/design/switch-features.md §3, scripts/event.ts).
import Layout from '../../layouts/Layout.astro';
---

<Layout lang="en" path="e" title="Event album" description="See the photos everyone added, and add yours." noindex>
  <section class="block event" id="event">
    <div class="narrow">
      <p class="kicker">Event album</p>
      <h1 id="event-name">Loading…</h1>
      <p class="lead" id="event-meta"></p>
      <div class="actions" id="event-actions">
        <label class="btn btn-primary" id="event-add" for="event-files">Add photos and videos</label>
        <input id="event-files" type="file" accept="image/jpeg,image/png,image/webp,image/heic,image/heif,video/mp4,video/quicktime,.mov,.m4v" multiple hidden />
        <a class="btn" id="open-app" href="/download/">Open in Lens</a>
      </div>
      <p class="note status" id="event-status" role="status" hidden></p>
      <p class="note" id="event-keep" hidden>
        You added them as a guest on this browser. To keep them with you and see everything in full quality, <a href="/download/">get Lens</a>
        or <a href="/signin/">sign in</a>.
      </p>
      <p class="note" id="event-note">
        Anyone with this link can see the album and add photos and videos. Your photos stay yours: in the Lens app you can remove them, or leave, any time.
      </p>
    </div>
    <div class="event-grid" id="event-grid" aria-live="polite"></div>
    <p class="note event-empty" id="event-empty" hidden>No photos yet. Be the first to add some.</p>
    <p class="note report"><a id="event-report" href="/contact/?topic=report" rel="nofollow">Report this album</a></p>
  </section>
</Layout>

<style>
  .report a {
    color: inherit;
    opacity: 0.7;
  }
  .kicker {
    color: var(--accent, #facc15);
    font: 600 12px/1 var(--mono, ui-monospace, monospace);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  #event-add {
    cursor: pointer;
  }
  #event-add.busy {
    opacity: 0.5;
    pointer-events: none;
  }
  .status.error {
    color: #ff453a;
  }
  .event-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(110px, 1fr));
    gap: 3px;
    max-width: 960px;
    margin: 32px auto 0;
    padding: 0 16px;
  }
  .event-grid img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    display: block;
    background: #1c1c1e;
  }
  .event-empty {
    text-align: center;
  }
</style>

<script>
  import '../../scripts/event.ts';
</script>
