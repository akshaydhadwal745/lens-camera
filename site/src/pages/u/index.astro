---
// /u/<id>/: a friend's "My Lens code" (Settings → My Lens code). With Lens
// installed, Android opens the app straight away (App Links) to pick photos for
// exactly that person; otherwise this page hands off to the app or explains.
import Layout from '../../layouts/Layout.astro';
---

<Layout lang="en" path="u" title="Lens code" description="Share photos with a friend on Lens." noindex>
  <section class="block">
    <div class="narrow">
      <h1>Share photos with your friend</h1>
      <p class="lead">This is a friend's Lens code. Open it in Lens to pick photos for exactly them. They accept before anything reaches them.</p>
      <div class="actions">
        <a class="btn btn-primary" id="open-app" href="/download/">Open in Lens</a>
        <a class="btn" href="/download/">Get the app</a>
      </div>
      <p class="note">
        Already in Lens? Tap <strong>Share</strong> on your photos, then <strong>Scan code</strong> and scan your friend's code. On a computer? Open the
        <a href="/app/">Lens web app</a> and search for their Lens name.
      </p>
      <hr />
      <p class="note" lang="hi">
        यह आपके दोस्त का Lens कोड है। Lens ऐप में खोलें और सिर्फ़ उन्हीं के साथ फ़ोटो शेयर करें। कुछ भी पहुँचने से पहले वे शेयर मंज़ूर करते हैं।
        ऐप नहीं है? <a href="/download/">Lens डाउनलोड करें</a>।
      </p>
    </div>
  </section>
</Layout>

<script>
  // The person id is the path segment after /u/. Android: an intent link opens
  // the installed app (or the download page); iPhone: the app's scheme.
  const id = location.pathname.split('/')[2] ?? '';
  const button = document.getElementById('open-app') as HTMLAnchorElement | null;
  if (button && /^[A-Za-z0-9_-]{6,64}$/.test(id)) {
    button.href = /Android/i.test(navigator.userAgent)
      ? `intent://u/${id}#Intent;scheme=lens;package=com.instagrowapp.lens;S.browser_fallback_url=${encodeURIComponent(location.origin + '/download/')};end`
      : `lens://u/${id}`;
  }
</script>
