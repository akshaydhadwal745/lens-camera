---
// Help centre in the "Keynote" style: search, topic cards, questions grouped
// by topic (native <details>, deep-linkable #topic-question ids), one FAQPage
// schema for the whole page, and a contact band. Content: src/content/help.ts.
import Layout from '../layouts/Layout.astro';
import { helpCopy, helpTopics } from '../content/help';
import { href, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = helpCopy[lang];
const topics = helpTopics[lang];

// Simple line icons (24×24, stroke = currentColor).
const icons: Record<string, string> = {
  start: 'M12 3v12m0 0-4.5-4.5M12 15l4.5-4.5M4.5 15.5v2A2.5 2.5 0 0 0 7 20h10a2.5 2.5 0 0 0 2.5-2.5v-2',
  camera: 'M4 8.5A2.5 2.5 0 0 1 6.5 6h1.2l1.4-2h5.8l1.4 2h1.2A2.5 2.5 0 0 1 20 8.5v8a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 16.5zM12 16a3.5 3.5 0 1 0 0-7 3.5 3.5 0 0 0 0 7',
  cloud: 'M7 18.5a4.5 4.5 0 0 1-.6-8.96A6 6 0 0 1 18 9.5a4.5 4.5 0 0 1-.5 9zM12 16v-5m0 0-2.2 2.2M12 11l2.2 2.2',
  phone: 'M8 2.5h8A1.5 1.5 0 0 1 17.5 4v16a1.5 1.5 0 0 1-1.5 1.5H8A1.5 1.5 0 0 1 6.5 20V4A1.5 1.5 0 0 1 8 2.5zM10.5 18.5h3',
  storage: 'M4 7c0-1.7 3.6-3 8-3s8 1.3 8 3-3.6 3-8 3-8-1.3-8-3zm0 0v10c0 1.7 3.6 3 8 3s8-1.3 8-3V7M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3',
  trash: 'M4.5 6.5h15M9.5 6.5V4.5h5v2M6.5 6.5l.9 12.6a1.5 1.5 0 0 0 1.5 1.4h6.2a1.5 1.5 0 0 0 1.5-1.4l.9-12.6M10 10.5v6M14 10.5v6',
  laptop: 'M5 5.5A1.5 1.5 0 0 1 6.5 4h11A1.5 1.5 0 0 1 19 5.5V15H5zM2.5 15h19l-1 3a1.5 1.5 0 0 1-1.4 1H4.9a1.5 1.5 0 0 1-1.4-1z',
  person: 'M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM4.5 20.5c.8-3.6 3.8-6 7.5-6s6.7 2.4 7.5 6',
};

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: topics.flatMap((t) => t.items.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } }))),
};
---

<Layout lang={lang} path="help" title={c.title} description={c.description}>
  <section class="hc-hero">
    <p class="kn-kicker">{c.kicker}</p>
    <h1 class="dl-title">{c.h1}</h1>
    <p class="kn-lead">{c.lead}</p>
    <form class="hc-search" role="search" action="#" data-help-search>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.5 18a7.5 7.5 0 1 0 0-15 7.5 7.5 0 0 0 0 15zM21 21l-5.2-5.2"></path></svg>
      <input type="search" name="q" placeholder={c.search} aria-label={c.searchLabel} autocomplete="off" enterkeyhint="search" />
    </form>
  </section>

  <nav class="hc-topics" aria-label={c.topicsLabel} data-help-topics>
    {
      topics.map((t) => (
        <a class="hc-topic" href={`#${t.id}`}>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d={icons[t.icon]} />
          </svg>
          <strong>{t.title}</strong>
          <span>{t.blurb}</span>
        </a>
      ))
    }
  </nav>

  <div class="hc-body">
    {
      topics.map((t) => (
        <section class="hc-group" id={t.id} aria-labelledby={`${t.id}-title`} data-help-group>
          <div class="hc-group-head">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d={icons[t.icon]} />
            </svg>
            <h2 id={`${t.id}-title`}>{t.title}</h2>
            <span>{c.questions(t.items.length)}</span>
          </div>
          <div class="faq">
            {t.items.map((f) => (
              <details id={`${t.id}-${f.id}`} data-help-item>
                <summary>{f.q}</summary>
                <p>
                  {f.a}
                  {f.link && (
                    <>
                      {' '}
                      <a href={href(lang, f.link[1])}>{f.link[0]} ›</a>
                    </>
                  )}
                </p>
              </details>
            ))}
          </div>
        </section>
      ))
    }
    <p class="hc-empty" hidden data-help-empty>
      {c.noResults} <a href={href(lang, 'contact')}>{c.noResultsLink} ›</a>
    </p>
  </div>

  <section class="kn-wide">
    <div class="hc-stuck">
      <div>
        <h2>{c.stuckTitle}</h2>
        <p>{c.stuckText}</p>
        <a class="btn btn-primary" href={href(lang, 'contact')}>{c.stuckButton}</a>
      </div>
      <p class="hc-tip">{c.stuckTip}</p>
    </div>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</Layout>

<script>
  import '../scripts/help';
</script>
