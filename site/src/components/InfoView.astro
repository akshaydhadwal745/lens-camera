---
// Pricing, security, download and help pages.
import Breadcrumbs from './Breadcrumbs.astro';
import Cta from './Cta.astro';
import Faq from './Faq.astro';
import type { Faq as FaqItem, PageCopy } from '../content/pages';
import Layout from '../layouts/Layout.astro';
import { href, type Lang, ui } from '../i18n/ui';

interface Props {
  lang: Lang;
  path: string;
  name: string;
  copy: PageCopy;
  faq?: FaqItem[];
  links?: [string, string][];
  /** Breadcrumbs after Home; defaults to this page alone. */
  trail?: [string, string][];
}
const { lang, path, name, copy, faq, links = [], trail = [[name, path]] } = Astro.props;
const t = ui[lang];
---

<Layout lang={lang} path={path} title={copy.title} description={copy.description}>
  <section class="pg-hero">
    <Breadcrumbs lang={lang} trail={trail} />
    <p class="kn-kicker">{name}</p>
    <h1>{copy.h1}</h1>
    <p class="kn-lead">{copy.lead}</p>
  </section>
  <div class="pg-rows">
    {
      copy.sections.map((s) => (
        <section class="pg-row">
          <h2>{s.h2}</h2>
          <div>
            {s.body.map((p) => <p>{p}</p>)}
            {s.table && (
              <div class="table-wrap">
                <table class="pg-table">
                  <caption class="sr-only">{s.table.caption}</caption>
                  <thead>
                    <tr>
                      {s.table.head.map((h) => (
                        <th scope="col">{h}</th>
                      ))}
                    </tr>
                  </thead>
                  <tbody>
                    {s.table.rows.map(([label, ...cells]) => (
                      <tr>
                        <th scope="row">{label}</th>
                        {cells.map((c) => (
                          <td>{c}</td>
                        ))}
                      </tr>
                    ))}
                  </tbody>
                </table>
              </div>
            )}
            {s.bullets && (
              <ul class="checks">
                {s.bullets.map((b) => <li>{b}</li>)}
              </ul>
            )}
          </div>
        </section>
      ))
    }
    {
      links.length > 0 && (
        <nav class="pg-links" aria-label={name}>
          {links.map(([label, p]) => (
            <a href={p.startsWith('/') ? p : href(lang, p)}>{label} ›</a>
          ))}
        </nav>
      )
    }
  </div>
  {
    faq && (
      <section class="block">
        <div class="narrow">
          <Faq title={t.faqTitle} items={faq} />
        </div>
      </section>
    )
  }
  <Cta lang={lang} />
</Layout>
