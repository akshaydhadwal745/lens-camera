---
// Pricing, security, download and help pages.
import Breadcrumbs from './Breadcrumbs.astro';
import Cta from './Cta.astro';
import Faq from './Faq.astro';
import type { Faq as FaqItem, PageCopy } from '../content/pages';
import Layout from '../layouts/Layout.astro';
import { href, type Lang, ui } from '../i18n/ui';

interface Props {
  lang: Lang;
  path: string;
  name: string;
  copy: PageCopy;
  faq?: FaqItem[];
  links?: [string, string][];
}
const { lang, path, name, copy, faq, links = [] } = Astro.props;
const t = ui[lang];
---

<Layout lang={lang} path={path} title={copy.title} description={copy.description}>
  <section class="hero">
    <div class="narrow">
      <Breadcrumbs lang={lang} trail={[[name, path]]} />
      <h1>{copy.h1}</h1>
      <p class="lead">{copy.lead}</p>
    </div>
  </section>
  <article class="narrow prose">
    {
      copy.sections.map((s) => (
        <section>
          <h2>{s.h2}</h2>
          {s.body.map((p) => <p>{p}</p>)}
          {s.bullets && (
            <ul class="checks">
              {s.bullets.map((b) => <li>{b}</li>)}
            </ul>
          )}
        </section>
      ))
    }
    {
      links.length > 0 && (
        <p>
          {links.map(([label, p], i) => (
            <>
              {i > 0 && ' · '}
              <a href={href(lang, p)}>{label}</a>
            </>
          ))}
        </p>
      )
    }
    {faq && <Faq title={t.faqTitle} items={faq} />}
  </article>
  <Cta lang={lang} />
</Layout>
