---
// /features/, /use-cases/ and /guides/: every page in the group, with descriptions.
import Breadcrumbs from './Breadcrumbs.astro';
import Cta from './Cta.astro';
import { guideHubPages } from '../content/guides';
import { featurePages, useCasePages } from '../content/pages';
import Layout from '../layouts/Layout.astro';
import { href, type Lang, ui } from '../i18n/ui';

interface Props {
  lang: Lang;
  group: 'features' | 'use-cases' | 'guides';
}
const { lang, group } = Astro.props;
const t = ui[lang];
const list = group === 'guides' ? [] : group === 'features' ? featurePages : useCasePages;
const guides = group === 'guides' ? guideHubPages : [];
const copy = {
  features: {
    en: { title: 'Features: pro camera, free full-quality backup, Night & Portrait, web app', description: 'Everything Lens does: a pro camera, original-quality backup, your own storage, 4K streaming, sharing, a non-destructive editor and a web app.', h1: 'Features' },
    hi: { title: 'फ़ीचर: प्रो कैमरा, मुफ़्त फ़ुल क्वालिटी बैकअप, नाइट और पोर्ट्रेट, वेब ऐप', description: 'Lens क्या-क्या करता है: प्रो कैमरा, ओरिजिनल क्वालिटी बैकअप, अपना स्टोरेज, 4K स्ट्रीमिंग, शेयरिंग, एडिटर और वेब ऐप।', h1: 'फ़ीचर' },
  },
  'use-cases': {
    en: { title: 'Use cases: storage full, travel, weddings and events', description: 'How Lens helps when your phone is full, on trips, and at weddings and events.', h1: 'Use cases' },
    hi: { title: 'इस्तेमाल: स्टोरेज फ़ुल, ट्रैवल, शादी और इवेंट', description: 'फ़ोन फ़ुल होने पर, ट्रिप पर, और शादी व इवेंट में Lens कैसे मदद करता है।', h1: 'इस्तेमाल' },
  },
  guides: {
    en: { title: 'Guides: storage full, full-quality sharing, wedding photos', description: 'Practical answers to everyday photo problems: a full phone or Google storage, compressed WhatsApp photos, and collecting everyone’s event photos.', h1: 'Guides' },
    hi: { title: 'गाइड: स्टोरेज फ़ुल, फ़ुल क्वालिटी शेयरिंग, शादी की फ़ोटो', description: 'फ़ोटो की रोज़ की समस्याओं के काम के जवाब: फ़ोन या Google स्टोरेज फ़ुल, WhatsApp पर कंप्रेस होती फ़ोटो, और इवेंट की सबकी फ़ोटो इकट्ठा करना।', h1: 'गाइड' },
  },
}[group][lang];
---

<Layout lang={lang} path={group} title={copy.title} description={copy.description}>
  <section class="hero">
    <div class="container">
      <Breadcrumbs lang={lang} trail={[[copy.h1, group]]} />
      <h1>{copy.h1}</h1>
      <p class="lead">{copy.description}</p>
    </div>
  </section>
  <section class="block">
    <div class="container grid">
      {
        list.map((p) => (
          <a class="card" href={href(lang, `${group}/${p.slug}`)}>
            <img class="card-media" src={`/media/card-${p.slug}.webp`} alt="" width="640" height="400" loading="lazy" decoding="async" />
            <h2 class="h3">{p.name[lang]}</h2>
            <p>{p.copy[lang].description}</p>
          </a>
        ))
      }
      {
        guides.map((g) => (
          <a class="card" href={href(lang, g.path)}>
            <h2 class="h3">{g.name[lang]}</h2>
            <p>{g.copy[lang].description}</p>
          </a>
        ))
      }
    </div>
  </section>
  <Cta lang={lang} />
</Layout>
