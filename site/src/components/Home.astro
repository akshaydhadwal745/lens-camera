      <h2 class="kn-display">{copy.finale}</h2>
      <div class="actions kn-center">
        <a class="btn btn-primary" href={href(lang, 'download')}>{copy.finaleGet}</a>
        <a class="btn btn-ghost" href={href(lang, 'signin')}>{copy.web}</a>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="narrow">
      <Faq title={copy.faqTitle} items={copy.faq} />
    </div>
  </section>
</Layout>

<script>
  // Background loops are decoration: they load only after the page has
  // finished loading, play only while on screen (saves data and battery), and
  // never with "reduce motion" (the stills stay).
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-src]');
  const start = () => {
    if (reduce || !('IntersectionObserver' in window)) return;
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) {
          if (!v.src) v.src = v.dataset.src ?? '';
          v.play().catch(() => {});
        } else {
          v.pause();
        }
      }
    });
    videos.forEach((v) => io.observe(v));
  };
  if (document.readyState === 'complete') start();
  else window.addEventListener('load', start, { once: true });
</script>
