  </section>

  <section class="kn-wide kn-centered">
    <h2 class="kn-display-md">{copy.webTitle}</h2>
    <p class="kn-text kn-measure-sm kn-auto">{copy.webText}</p>
    <div class="kn-laptop" aria-hidden="true">
