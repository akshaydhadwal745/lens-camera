---
import Cta from './Cta.astro';
import Faq from './Faq.astro';
import { featurePages, useCasePages } from '../content/pages';
import Layout from '../layouts/Layout.astro';
import { BRAND, href, type Lang, ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = ui[lang];
const site = Astro.site!.origin;

const copy = {
  en: {
    title: 'Lens by InstaGrow: pro camera + 100 GB free photo backup at original quality',
    description:
      'Shoot endlessly, your phone never fills up. A pro camera with Night and Portrait modes, 100 GB free backup at original quality, your own Google Drive or Dropbox, and a web app.',
    eyebrow: 'Camera + cloud, in one app',
    h1: 'Shoot endlessly. Your phone never fills up.',
    lead: 'Lens is a pro camera that backs up every photo and video at original quality the moment you take it, then frees your phone for you.',
    web: 'Use on the web',
    note: 'Free: 100 GB when you sign in. Android first; iPhone coming.',
    trust: [
      ['Original quality, always', 'Never compressed. Every upload is verified.'],
      ['100 GB free', 'Or connect Google Drive, OneDrive, Dropbox, Box or a NAS.'],
      ['Stored in India', 'AWS Mumbai. Encrypted. Delete anytime.'],
    ],
    featuresTitle: 'Everything a camera roll should have been',
    featuresLead: 'A camera, a backup and a gallery that work together, on your phone and on the web.',
    howTitle: 'How it works',
    how: [
      ['Shoot', 'Use the Lens camera: pro controls, Night, Portrait and live looks.'],
      ['It backs up instantly', 'Original quality, verified, even while you record video.'],
      ['Your phone stays free', 'Lens removes full-size copies that are safe in the cloud and keeps sharp previews.'],
    ],
    useTitle: 'Made for the moments that fill your phone',
    faq: [
      { q: 'Is Lens free?', a: 'Yes. Sign in with your email or Google account and you get 100 GB of backup free. Without signing in you can try Lens with 5 GB. Paid plans with more storage will come later.' },
      { q: 'Will my photos lose quality?', a: 'No. Lens stores the exact original file. Previews are extra, for speed. When you open, share or save a photo you get the original.' },
      { q: 'Which phones does Lens work on?', a: 'Lens launches on Android 7 and newer, from budget phones to flagships, and shows only the camera features your phone supports. An iPhone version is built and coming later.' },
      { q: 'Can I see my photos on a computer?', a: 'Yes. Open this website, scan the QR code with your phone, and your library is on your computer, in sync with your phone.' },
      { q: 'Where are my photos stored?', a: 'In Amazon Web Services, Mumbai region (India), encrypted at rest. Or in your own Google Drive, OneDrive, Dropbox, Box, S3 or NAS if you connect one.' },
    ],
  },
  hi: {
    title: 'Lens by InstaGrow: प्रो कैमरा + ओरिजिनल क्वालिटी में 100 GB मुफ़्त फ़ोटो बैकअप',
    description:
      'जितनी चाहें फ़ोटो लें, फ़ोन कभी फ़ुल नहीं होगा। नाइट और पोर्ट्रेट मोड वाला प्रो कैमरा, ओरिजिनल क्वालिटी में 100 GB मुफ़्त बैकअप, आपका अपना Google Drive या Dropbox, और वेब ऐप।',
    eyebrow: 'कैमरा + क्लाउड, एक ही ऐप में',
    h1: 'जितनी चाहें फ़ोटो लें। फ़ोन कभी फ़ुल नहीं होगा।',
    lead: 'Lens एक प्रो कैमरा है जो हर फ़ोटो और वीडियो का लेते ही ओरिजिनल क्वालिटी में बैकअप करता है, फिर आपके लिए फ़ोन ख़ाली करता है।',
    web: 'वेब पर इस्तेमाल करें',
    note: 'मुफ़्त: साइन इन करने पर 100 GB। पहले Android; iPhone जल्द।',
    trust: [
      ['हमेशा ओरिजिनल क्वालिटी', 'कभी कंप्रेस नहीं। हर अपलोड की जाँच होती है।'],
      ['100 GB मुफ़्त', 'या Google Drive, OneDrive, Dropbox, Box या NAS जोड़ें।'],
      ['भारत में स्टोर', 'AWS मुंबई। एन्क्रिप्टेड। कभी भी डिलीट करें।'],
    ],
    featuresTitle: 'कैमरा रोल में जो होना चाहिए था, वो सब',
    featuresLead: 'कैमरा, बैकअप और गैलरी जो साथ मिलकर काम करते हैं, फ़ोन पर भी और वेब पर भी।',
    howTitle: 'यह कैसे काम करता है',
    how: [
      ['फ़ोटो लें', 'Lens कैमरा इस्तेमाल करें: प्रो कंट्रोल, नाइट, पोर्ट्रेट और लाइव लुक्स।'],
      ['तुरंत बैकअप', 'ओरिजिनल क्वालिटी, जाँचा हुआ, वीडियो रिकॉर्ड करते समय भी।'],
      ['फ़ोन ख़ाली रहता है', 'क्लाउड में सुरक्षित बड़ी फ़ाइलें Lens हटा देता है और साफ़ प्रीव्यू रखता है।'],
    ],
    useTitle: 'उन पलों के लिए बना जो फ़ोन भर देते हैं',
    faq: [
      { q: 'क्या Lens मुफ़्त है?', a: 'हाँ। ईमेल या Google अकाउंट से साइन इन करें और 100 GB बैकअप मुफ़्त पाएँ। बिना साइन इन के आप 5 GB के साथ आज़मा सकते हैं। ज़्यादा स्टोरेज वाले पेड प्लान बाद में आएँगे।' },
      { q: 'क्या मेरी फ़ोटो की क्वालिटी कम होगी?', a: 'नहीं। Lens ठीक वही ओरिजिनल फ़ाइल रखता है। प्रीव्यू सिर्फ़ तेज़ी के लिए अलग से हैं। फ़ोटो खोलने, शेयर या सेव करने पर आपको ओरिजिनल मिलता है।' },
      { q: 'Lens किन फ़ोन पर चलता है?', a: 'Lens Android 7 और नए वर्शन पर लॉन्च हो रहा है, बजट फ़ोन से फ़्लैगशिप तक, और सिर्फ़ वही कैमरा फ़ीचर दिखाता है जो आपका फ़ोन सपोर्ट करता है। iPhone वर्शन बना हुआ है और बाद में आएगा।' },
      { q: 'क्या कंप्यूटर पर फ़ोटो देख सकते हैं?', a: 'हाँ। यह वेबसाइट खोलें, फ़ोन से QR कोड स्कैन करें, और आपकी लाइब्रेरी कंप्यूटर पर, फ़ोन के साथ सिंक।' },
      { q: 'मेरी फ़ोटो कहाँ स्टोर होती हैं?', a: 'Amazon Web Services के मुंबई रीजन (भारत) में, एन्क्रिप्टेड। या आपके अपने Google Drive, OneDrive, Dropbox, Box, S3 या NAS में, अगर आप जोड़ते हैं।' },
    ],
  },
}[lang];

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: BRAND,
  operatingSystem: 'Android 7.0+',
  applicationCategory: 'PhotographyApplication',
  description: copy.description,
  url: `${site}${href(lang)}`,
  image: `${site}/icon-512.png`,
  inLanguage: lang === 'en' ? 'en-IN' : 'hi-IN',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'INR' },
  featureList: featurePages.map((p) => p.name[lang]),
  publisher: { '@id': `${site}/#org` },
};
---

<Layout lang={lang} path="" title={copy.title} description={copy.description} bareTitle jsonLd={[appSchema]}>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="eyebrow">{copy.eyebrow}</span>
        <h1>{copy.h1}</h1>
        <p class="lead">{copy.lead}</p>
        <div class="actions">
          <a class="btn btn-primary" href={href(lang, 'download')}>{t.getApp}</a>
          <a class="btn btn-ghost" href={href(lang, 'signin')}>{copy.web}</a>
        </div>
        <p class="note">{copy.note}</p>
      </div>
      <div class="hero-art" aria-hidden="true">
        <img src="/mark.svg" alt="" width="512" height="512" />
      </div>
    </div>
  </section>

  <section class="block alt">
    <h2 class="sr-only">{lang === 'en' ? 'Why Lens' : 'Lens क्यों'}</h2>
    <div class="container grid grid-3">
      {
        copy.trust.map(([h, p]) => (
          <div class="card">
            <h3>{h}</h3>
            <p>{p}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="block">
    <div class="container">
      <div class="section-head">
        <h2>{copy.featuresTitle}</h2>
        <p class="lead">{copy.featuresLead}</p>
      </div>
      <div class="grid grid-3">
        {
          featurePages.map((p) => (
            <a class="card" href={href(lang, `features/${p.slug}`)}>
              <div class="icon" aria-hidden="true">{p.icon}</div>
              <h3>{p.name[lang]}</h3>
              <p>{p.copy[lang].description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="block alt">
    <div class="container">
      <div class="section-head"><h2>{copy.howTitle}</h2></div>
      <ol class="steps">
        {
          copy.how.map(([h, p]) => (
            <li>
              <h3>{h}</h3>
              <p class="muted">{p}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="block">
    <div class="container">
      <div class="section-head"><h2>{copy.useTitle}</h2></div>
      <div class="grid">
        {
          useCasePages.map((p) => (
            <a class="card" href={href(lang, `use-cases/${p.slug}`)}>
              <div class="icon" aria-hidden="true">{p.icon}</div>
              <h3>{p.name[lang]}</h3>
              <p>{p.copy[lang].lead}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <div class="narrow">
    <Faq title={t.faqTitle} items={copy.faq} />
  </div>

  <Cta lang={lang} />
</Layout>
