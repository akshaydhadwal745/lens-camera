  </section>

  <section class="kn-statement hp-camera-intro">
    <p><span>{copy.cameraTitle}</span></p>
  </section>

  <section class="kn-wide">
    <div class="kn-head">
      <h2 class="kn-display">{copy.nightTitle}</h2>
