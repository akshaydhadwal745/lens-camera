        </div>
        <a class="hp-link hp-link-gap" href={href(lang, 'guides/send-full-quality-photos-whatsapp')}>{copy.shareLink} ›</a>
      </div>
      <div class="hp-compare" role="img" aria-label={copy.shareAlt}>
        <div class="kn-frame hp-compare-shot">
          <img class="hp-crushed" src="/media/mosaic-3.webp" alt="" width="600" height="813" loading="lazy" decoding="async" />
          <span class="hp-tag">{copy.shareChat}</span>
        </div>
        <div class="kn-frame hp-compare-shot">
          <img src="/media/mosaic-3.webp" alt="" width="600" height="813" loading="lazy" decoding="async" />
          <span class="hp-tag hp-tag-on">{copy.shareLens}</span>
        </div>
      </div>
