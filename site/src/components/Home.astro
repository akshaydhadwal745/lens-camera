      { q: 'क्या मेरी फ़ोटो की क्वालिटी कम होगी?', a: 'नहीं। Lens ठीक वही ओरिजिनल फ़ाइल रखता है। प्रीव्यू सिर्फ़ तेज़ी के लिए हैं। फ़ोटो खोलने, शेयर या सेव करने पर ओरिजिनल मिलता है।' },
      { q: 'क्या इवेंट एल्बम में फ़ोटो जोड़ने के लिए मेहमानों को Lens चाहिए?', a: 'नहीं। वे फ़ोन कैमरा से QR कोड स्कैन करके ब्राउज़र से फ़ोटो जोड़ते हैं। वीडियो के लिए ऐप चाहिए।' },
      { q: 'Lens किन फ़ोन पर चलता है?', a: 'Android 7 और नए, बजट फ़ोन से फ़्लैगशिप तक। Lens आपके फ़ोन के कैमरे के हिसाब से ढल जाता है। iPhone वर्शन बना हुआ है और बाद में आएगा।' },
      { q: 'मेरी फ़ोटो कहाँ स्टोर होती हैं?', a: 'Amazon Web Services के मुंबई (भारत) रीजन में, एन्क्रिप्टेड। या आपके अपने Google Drive, OneDrive, Dropbox, Box, S3 या NAS में, अगर आप जोड़ते हैं।' },
    ],
  },
}[lang];

const mosaic = ['mosaic-1', 'mosaic-2', 'mosaic-3', 'mosaic-4', 'mosaic-5', 'mosaic-6', 'mosaic-7', 'mosaic-8'];
const library = ['lib-1', 'lib-2', 'lib-3', 'lib-4', 'lib-5', 'lib-6', 'portrait', 'mosaic-5', 'mosaic-3', 'mosaic-7', 'mosaic-4', 'mosaic-6', 'mosaic-8', 'mosaic-2', 'mosaic-1'];

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'MobileApplication',
  name: BRAND,
  operatingSystem: 'Android 7.0+',
  applicationCategory: 'PhotographyApplication',
  description: copy.description,
  url: `${site}${href(lang)}`,
  image: `${site}/icon-512.png`,
  inLanguage: lang === 'en' ? 'en' : 'hi',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  featureList: featurePages.map((p) => p.name[lang]),
  publisher: { '@id': `${site}/#org` },
};
---

<Layout lang={lang} path="" title={copy.title} description={copy.description} bareTitle jsonLd={[appSchema]}>
  <section class="kn-hero">
    <!-- The still loads first (it's what the page is judged on); the loop starts after load. -->
    <img class="kn-bg" src="/media/hero-poster.webp" alt="" width="1280" height="674" fetchpriority="high" decoding="async" />
    <video class="kn-bg" data-src="/media/hero.mp4" muted loop playsinline preload="none" aria-hidden="true"></video>
    <div class="kn-shade"></div>
    <div class="kn-hero-copy">
      <p class="kn-kicker">{copy.kicker}</p>
      <h1>{copy.h1}</h1>
      <p class="kn-lead">{copy.lead}</p>
      <div class="actions kn-center">
        <a class="btn btn-primary" href={href(lang, 'download')}>{copy.get}</a>
        <a class="btn btn-ghost" href={href(lang, 'signin')}>{copy.web}</a>
      </div>
