        {mosaic.map((m) => <img src={`/media/${m}.webp`} alt="" loading="lazy" decoding="async" />)}
      </div>
      <div class="kn-big-stats">
        {copy.backupStats.map(([v, l]) => <div><strong>{v}</strong><span>{l}</span></div>)}
      </div>
    </div>
