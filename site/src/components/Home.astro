          <div class="kn-laptop-grid">
            {library.map((m) => <img src={`/media/${m}.webp`} alt="" loading="lazy" decoding="async" />)}
          </div>
        </div>
      </div>
      <div class="kn-laptop-base"></div>
    </div>
  </section>

  <section class="kn-band">
    <div class="kn-wide kn-flush">
      <h2 class="kn-display-md kn-measure">{copy.trustTitle}</h2>
      <div class="kn-spec-grid hp-trust">
        {
          copy.trust.map(([h, p]) => (
            <div>
              <h3>{h}</h3>
              <p>{p}</p>
            </div>
          ))
        }
      </div>
      <a class="hp-link hp-link-gap" href={href(lang, 'trust')}>{copy.trustLink} ›</a>
    </div>
